{
  "name": "JobPilot - Unified Automation Suite",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "value": 5
            }
          ]
        }
      },
      "id": "e4f8d2b1-1234-4567-89ab-cdef01234567",
      "name": "Every 5 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [100, 100]
    },
    {
      "parameters": {
        "operation": "getAll",
        "limit": 10,
        "simple": false,
        "filters": {
          "q": "subject:(interview OR application OR rejection OR offer OR assessment OR update)"
        }
      },
      "id": "f5e9c3b2-2345-5678-90ab-cdef01234568",
      "name": "Fetch Recruiter Emails",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2,
      "position": [300, 100],
      "credentials": {
        "gmailOAuth2": {
          "id": "gmail-oauth-credentials",
          "name": "Gmail OAuth2 Credentials"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/v1/ai/classify-email",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "Bearer 535a48497f21e13c1cfe5e4585d17d3b"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"subject\": \"{{ $json.subject }}\",\n  \"body\": \"{{ $json.textPlain || $json.textHtml }}\",\n  \"from_address\": \"{{ $json.from.value[0].address }}\"\n}",
        "options": {}
      },
      "id": "a6d8c2b3-3456-6789-01ab-cdef01234569",
      "name": "AI Classify via Local LLM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [520, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://backend:8000/api/v1/webhooks/n8n",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer 535a48497f21e13c1cfe5e4585d17d3b"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"event\": \"email_classified\",\n  \"gmail_message_id\": \"{{ $('Fetch Recruiter Emails').item.json.id }}\",\n  \"subject\": \"{{ $('Fetch Recruiter Emails').item.json.subject }}\",\n  \"from_address\": \"{{ $('Fetch Recruiter Emails').item.json.from.value[0].address }}\",\n  \"classification\": \"{{ $json.data.classification }}\",\n  \"ai_parsed_data\": {{ JSON.stringify($json.data) }},\n  \"timestamp\": \"{{ new Date().toISOString() }}\"\n}",
        "options": {}
      },
      "id": "b7e9d3c4-4567-7890-12ab-cdef01234570",
      "name": "Callback to FastAPI CRM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [740, 100]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "parse-job",
        "options": {}
      },
      "id": "c1a2b3c4-d5e6-7f8a-9b0c-1d2e3f4a5b6c",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [100, 350]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/v1/ai/parse-job",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "Bearer 535a48497f21e13c1cfe5e4585d17d3b"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"text\": \"{{ $json.body.job_description_raw }}\"\n}",
        "options": {}
      },
      "id": "d2b3c4d5-e6f7-8a9b-0c1d-2e3f4a5b6c7d",
      "name": "AI Parse via Local LLM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [300, 350]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=http://backend:8000/api/v1/applications/{{ $('Webhook Trigger').item.json.body.application_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Webhook Trigger').item.json.headers.authorization.split(' ')[1] }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"company_name\": \"{{ $json.data.company_name }}\",\n  \"job_title\": \"{{ $json.data.job_title }}\",\n  \"location\": \"{{ $json.data.location }}\",\n  \"work_type\": \"{{ $json.data.work_type }}\",\n  \"salary_range\": \"{{ $json.data.salary_range }}\",\n  \"technologies\": {{ JSON.stringify($json.data.technologies) }},\n  \"job_description_parsed\": {{ JSON.stringify($json.data) }}\n}",
        "options": {}
      },
      "id": "e3c4d5e6-f7a8-9b0c-1d2e-3f4a5b6c7d8e",
      "name": "Update CRM Application",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [520, 350]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "telegram-alert",
        "options": {}
      },
      "id": "a1a1a1a1-2222-3333-4444-555555555555",
      "name": "Alert Trigger Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [100, 600]
    },
    {
      "parameters": {
        "chatId": "={{ $json.body.telegram_chat_id }}",
        "text": "=🔔 *JobPilot Notification* 🚀\n\n*{{ $json.body.title }}*\n\n{{ $json.body.message }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "b2b2b2b2-3333-4444-5555-666666666666",
      "name": "Send Bot Message",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [300, 600],
      "credentials": {
        "telegramApi": {
          "id": "telegram-bot-credentials",
          "name": "Telegram Bot API Credentials"
        }
      }
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "value": 1
            }
          ]
        }
      },
      "id": "c3c3c3c3-4444-5555-6666-777777777777",
      "name": "Daily Cron Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [100, 850]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://backend:8000/api/v1/follow-ups/due",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer 535a48497f21e13c1cfe5e4585d17d3b"
            }
          ]
        },
        "options": {}
      },
      "id": "d4d4d4d4-5555-6666-7777-888888888888",
      "name": "Fetch Due Follow-Ups",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [300, 850]
    },
    {
      "parameters": {
        "chatId": "={{ $json.telegram_chat_id }}",
        "text": "=⏰ *JobPilot Task Alert* ⏰\n\nYou have pending follow-up tasks due today:\n\n- *Task:* {{ $json.notes }}\n- *Due Date:* {{ $json.due_date }}\n\nAction: Send follow-up or mark as complete on your dashboard!",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "e5e5e5e5-6666-7777-8888-999999999999",
      "name": "Notify Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [520, 850],
      "credentials": {
        "telegramApi": {
          "id": "telegram-bot-credentials",
          "name": "Telegram Bot API Credentials"
        }
      }
    }
  ],
  "connections": {
    "Every 5 Minutes": {
      "main": [
        [
          {
            "node": "Fetch Recruiter Emails",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Recruiter Emails": {
      "main": [
        [
          {
            "node": "AI Classify via Local LLM",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Classify via Local LLM": {
      "main": [
        [
          {
            "node": "Callback to FastAPI CRM",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "AI Parse via Local LLM",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Parse via Local LLM": {
      "main": [
        [
          {
            "node": "Update CRM Application",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Alert Trigger Webhook": {
      "main": [
        [
          {
            "node": "Send Bot Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Daily Cron Trigger": {
      "main": [
        [
          {
            "node": "Fetch Due Follow-Ups",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Due Follow-Ups": {
      "main": [
        [
          {
            "node": "Notify Telegram",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateId": "jobpilot-unified-suite"
  }
}
