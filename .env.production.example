# Production environment template — copy to .env (DO NOT COMMIT secrets)

ENVIRONMENT=production
PROJECT_NAME=JobPilot
SECRET_KEY=change-me-to-a-random-64-char-string

# MongoDB (use managed Atlas or your connection string)
MONGODB_URL=mongodb+srv://<user>:<pass>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=jobpilot

# Redis (use managed Redis or a host:port)
REDIS_URL=redis://:<password>@<redis-host>:6379/0

# Backend
BACKEND_PORT=8000
# For production, set to your public domain or VPS IP. Example below uses the VPS IP.
# To allow requests from anywhere (not recommended), set to ["*"]
BACKEND_CORS_ORIGINS=["http://159.223.96.235"]

# Frontend
FRONTEND_PORT=3000
# Set to your public domain or VPS IP:
NEXT_PUBLIC_API_URL=http://159.223.96.235/api/v1

# Gemini (Google Generative AI)
# Create a restricted API key in AI Studio and paste here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=change-me-telegram-webhook-secret

# Gmail (OAuth credentials)
GMAIL_CLIENT_ID=your-google-client-id
GMAIL_CLIENT_SECRET=your-google-client-secret
GMAIL_REFRESH_TOKEN=your-refresh-token
GMAIL_USER_EMAIL=your-email@example.com

# Nginx / TLS
NGINX_PORT=80
NGINX_SSL_PORT=443

# Monitoring
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_password

# Other
EMAIL_CHECK_INTERVAL_SECONDS=300
